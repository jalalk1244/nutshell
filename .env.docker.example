# Optional local configuration. Copy to .env.docker and use:
# docker compose --env-file .env.docker up --build -d --wait
NUTSHELL_PORT=8001
# Local database only. Use URL-safe letters/numbers if changing this password.
POSTGRES_PASSWORD=nutshell-local-only
SECRET_KEY=docker-local-development-only
# Set Stripe TEST keys here only when manually testing payments.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WH_SECRET=
